{
  "name": "deck-allocator-for-archidekt",
  "version": "0.7.0",
  "description": "Browser extension for Archidekt: which physical copies are in which deck, and switching decks to free copies.",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc",
    "package": "node build.mjs && node scripts/package.mjs",
    "spike": "esbuild src/spike.ts --bundle --format=iife --target=es2020 --outfile=dist/deck-allocator-spike.js",
    "e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release-notes": "node scripts/release-notes.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module"
}
